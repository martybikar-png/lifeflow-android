<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.LifeFlow" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F2F3F7</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.LifeFlow.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F2F3F7</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/lifeflow_system_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.LifeFlow</item>
    </style>
</resources>
